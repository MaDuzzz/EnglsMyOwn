rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function owner() { return signedIn() && request.auth.uid == get(/databases/$(database)/documents/config/access).data.ownerUid; }
  function approved() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'; }
  match /config/{id} { allow read, write: if false; }
  match /users/{uid} {
   allow get: if signedIn() && (request.auth.uid == uid || owner());
   allow list: if owner();
   allow create: if signedIn() && request.auth.uid == uid
    && request.auth.token.email_verified == true
    && request.resource.data.keys().hasOnly(['uid','email','displayName','status','role'])
    && request.resource.data.uid == uid
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 200
    && request.resource.data.status == 'pending' && request.resource.data.role == 'learner';
   allow update: if owner() && uid != request.auth.uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && request.resource.data.status in ['pending','approved','revoked'];
   allow delete: if false;
  }
  match /words/{id} {
   allow read: if owner() || (approved() && resource.data.status == 'published');
   allow write: if owner();
  }
  match /lessons/{id} {
   allow read: if owner() || (approved() && resource.data.status == 'published');
   allow write: if owner();
  }
  match /learning/{uid} {
   allow read: if approved() && request.auth.uid == uid;
   allow get: if owner();
   allow create, update: if approved() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['records','plans','videos','savedVideos','pet','activeSession','blockedSessionId'])
    && request.resource.data.records is list && request.resource.data.records.size() <= 2000
    && request.resource.data.plans is map && request.resource.data.videos is map
    && request.resource.data.savedVideos is list && request.resource.data.pet is map
    && request.resource.data.pet.keys().hasOnly(['name','color','gender','pattern','species'])
    && (!('species' in request.resource.data.pet) || request.resource.data.pet.species in ['cat','dog','lion','tiger'])
    && request.resource.data.pet.name is string && request.resource.data.pet.name.size() <= 24
    && (!('activeSession' in request.resource.data)
      || request.resource.data.activeSession == null
      || (request.resource.data.activeSession is map
        && request.resource.data.activeSession.keys().hasOnly(['version','id','attemptId','mode','day','wordIds','queue','completed','introduced','round','answer','tokens','feedback','seconds','updatedAt'])
        && request.resource.data.activeSession.version == 1
        && request.resource.data.activeSession.id is string && request.resource.data.activeSession.id.size() <= 200
        && (!('attemptId' in request.resource.data.activeSession)
          || (request.resource.data.activeSession.attemptId is string
            && request.resource.data.activeSession.attemptId.size() <= 200))
        && request.resource.data.activeSession.mode in ['learn','review']
        && request.resource.data.activeSession.day is string && request.resource.data.activeSession.day.size() == 10
        && request.resource.data.activeSession.wordIds is list && request.resource.data.activeSession.wordIds.size() == 10
        && request.resource.data.activeSession.queue is list && request.resource.data.activeSession.queue.size() <= 40
        && request.resource.data.activeSession.completed is list && request.resource.data.activeSession.completed.size() <= 40
        && request.resource.data.activeSession.introduced is list && request.resource.data.activeSession.introduced.size() <= 10
        && request.resource.data.activeSession.round is int && request.resource.data.activeSession.round >= 1 && request.resource.data.activeSession.round <= 4
        && request.resource.data.activeSession.answer is string && request.resource.data.activeSession.answer.size() <= 500
        && request.resource.data.activeSession.tokens is list && request.resource.data.activeSession.tokens.size() <= 50
        && (request.resource.data.activeSession.feedback == null || request.resource.data.activeSession.feedback is bool)
        && request.resource.data.activeSession.seconds is number && request.resource.data.activeSession.seconds >= 0
        && request.resource.data.activeSession.updatedAt is int))
    && (!('blockedSessionId' in request.resource.data)
      || (request.resource.data.blockedSessionId is string
        && request.resource.data.blockedSessionId.size() <= 200));
   allow update: if owner() && uid != request.auth.uid
    && resource.data.activeSession is map
    && resource.data.activeSession.completed.size() < 40
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSession','blockedSessionId'])
    && request.resource.data.activeSession == null
    && request.resource.data.blockedSessionId ==
      ('attemptId' in resource.data.activeSession
        ? resource.data.activeSession.attemptId
        : resource.data.activeSession.id);
   allow delete: if false;
  }
  // A small public summary for approved learners. Detailed learning records
  // remain private in /learning. Scores are self-reported by the web client.
  match /rankings/{uid} {
   allow read: if approved();
   allow create, update: if approved() && request.auth.uid == uid
    && request.resource.data.keys().hasAll(['uid','displayName','appearance','petStage','weekKey','weekPoints','weekDays','weekWords','monthKey','monthWords','bestStreak','currentStreak','lastGoalDay','updatedDay'])
    && request.resource.data.keys().hasOnly(['uid','displayName','appearance','petStage','weekKey','weekPoints','weekDays','weekWords','monthKey','monthWords','bestStreak','currentStreak','lastGoalDay','updatedDay'])
    && request.resource.data.uid == uid
    && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40
    && request.resource.data.appearance in ['cat','dog','lion','lioness','tiger']
    && request.resource.data.petStage is int && request.resource.data.petStage >= 0 && request.resource.data.petStage <= 4
    && request.resource.data.weekKey is string && request.resource.data.weekKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.monthKey is string && request.resource.data.monthKey.matches('^[0-9]{4}-[0-9]{2}$')
    && request.resource.data.lastGoalDay is string && (request.resource.data.lastGoalDay == '' || request.resource.data.lastGoalDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
    && request.resource.data.updatedDay is string && request.resource.data.updatedDay.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && request.resource.data.weekPoints is int && request.resource.data.weekPoints >= 0 && request.resource.data.weekPoints <= 100000
    && request.resource.data.weekDays is int && request.resource.data.weekDays >= 0 && request.resource.data.weekDays <= 7
    && request.resource.data.weekWords is int && request.resource.data.weekWords >= 0 && request.resource.data.weekWords <= 20000
    && request.resource.data.monthWords is int && request.resource.data.monthWords >= 0 && request.resource.data.monthWords <= 20000
    && request.resource.data.bestStreak is int && request.resource.data.bestStreak >= 0 && request.resource.data.bestStreak <= 10000
    && request.resource.data.currentStreak is int && request.resource.data.currentStreak >= 0 && request.resource.data.currentStreak <= request.resource.data.bestStreak;
   allow delete: if owner();
  }
  match /{document=**} { allow read, write: if false; }
 }
}
